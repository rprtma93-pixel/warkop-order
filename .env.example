ADMIN_PASSWORD=ganti-password-ini
POSTGRES_USER=warkop
POSTGRES_PASSWORD=ganti-password-db
POSTGRES_DB=warkop

# Laravel: isi APP_KEY tetap agar sesi login tidak hilang saat restart.
# Cara membuat: docker compose run --rm admin php artisan key:generate --show
APP_KEY=

# Set true saat dipasang di Coolify (HTTPS lewat proxy)
FORCE_HTTPS=false
